[codespell]
# Ref: https://github.com/codespell-project/codespell#using-a-config-file
skip =
  .git,.gitignore,.gitattributes,.codespellrc,
  *.pdf,*.docx,*.zip,*.css,
  # Frozen v2.1 committee specification deliverables (already published)
  ./sarif-2.1/prose/*.htm,
  ./sarif-2.1/prose/*.json,
  # Generated v2.2 draft deliverables (regenerated from sarif-2.2/prose/edit/src)
  ./sarif-2.2/prose/share/*
check-hidden = true
# Do not flag typos inside URLs (link targets must stay verbatim)
ignore-regex = https?://\S+
ignore-words-list =
  # variable name in toccata.py, short for "present" (contrast with `past`)
  pres,
  # Synopsys is a company name (referenced in acknowledgements)
  synopsys,
  # Ned Freed - IETF person's actual first name (RFC 2045/2048 author)
  ned
